<Window x:Class="ShutdownTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Таймер выключения" Height="200" Width="450" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Часы:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Name="HoursBox" Width="50" Text="0" TextAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock Text="Минуты:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <TextBox Name="MinutesBox" Width="50" Text="0" TextAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock Text="Секунды:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <TextBox Name="SecondsBox" Width="50" Text="0" TextAlignment="Center" VerticalAlignment="Center"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1" Margin="0,0,0,15">
            <Button Name="ApplyBtn" Content="Применить таймер" Width="150" Height="30" Margin="0,0,10,0" Click="ApplyBtn_Click" Background="#FF4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button Name="CancelBtn" Content="Отменить таймер" Width="150" Height="30" Click="CancelBtn_Click" Background="#FFF44336" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <TextBlock Name="StatusText" Grid.Row="2" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"/>
    </Grid>
</Window>